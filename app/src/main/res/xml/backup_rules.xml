<?xml version="1.0" encoding="utf-8"?>
<!--
    Auto Backup rules for devices older than Android 12 (targetSdk 31+ uses
    data_extraction_rules.xml).

    Default Auto Backup covers most app-private data; this file only excludes
    large device-local assets and install-local state. Research data (Room
    database) and device settings (DataStore) remain included by default.

    - files/map-packages/  (staged and active offline PMTiles packages)
    - files/dev-bootstrap/ (DEV bootstrap fixtures)
    - files/install-state/ (Initial Setup offer state of one installation)
-->
<full-backup-content>
    <exclude domain="file" path="map-packages/" />
    <exclude domain="file" path="dev-bootstrap/" />
    <exclude domain="file" path="install-state/" />
</full-backup-content>
