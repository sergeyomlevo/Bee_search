<?xml version="1.0" encoding="utf-8"?>
<!--
    Auto Backup rules for devices older than Android 12 (targetSdk 31+ uses
    data_extraction_rules.xml).

    Default Auto Backup covers most app-private data; this file only excludes
    large device-local assets. Research data (Room database) and user settings
    (DataStore) remain included by default.
-->
<full-backup-content>
    <exclude domain="file" path="map-packages/" />
    <exclude domain="file" path="dev-bootstrap/" />
</full-backup-content>
