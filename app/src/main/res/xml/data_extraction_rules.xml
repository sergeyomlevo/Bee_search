<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ backup and device-transfer policy (targetSdk 31+).

    Default Android Auto Backup covers most app-private data. These rules only
    exclude large device-local assets and install-local state; research data
    (Room database) and device settings (DataStore) remain included by default.

    Excluded because they are re-downloadable/importable and can reach hundreds
    of megabytes:
    - files/map-packages/        (staged and active offline PMTiles packages)
    - files/dev-bootstrap/       (DEV bootstrap fixtures)

    Excluded because it belongs to one installation and must never return through
    a restore or a device transfer:
    - files/install-state/       (Initial Setup offer state)

    The settings DataStore (files/datastore/bee_search_settings.preferences_pb) is
    deliberately NOT excluded: current Territory, current Observer, map coverage and
    the remaining settings stay restorable. Android backup rules work on files, not
    on single preferences keys, which is why install-local state has its own file.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="map-packages/" />
        <exclude domain="file" path="dev-bootstrap/" />
        <exclude domain="file" path="install-state/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="map-packages/" />
        <exclude domain="file" path="dev-bootstrap/" />
        <exclude domain="file" path="install-state/" />
    </device-transfer>
</data-extraction-rules>
